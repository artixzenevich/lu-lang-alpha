# Шифр Цезаря на языке Lu
#
# Две версии:
# 1) простая — сдвиг по Unicode (любые символы)
# 2) алфавитная — с заворачиванием по русскому алфавиту А-Я, а-я (32 буквы, без Ё)


# ======== Версия 1: Простой сдвиг по Unicode ========

процедура цезарь_unicode(текст, сдвиг)
    запомнить результат = ""
    запомнить н = длина(текст)
    для i от 0 до н - 1
        результат = результат + символ(код(текст[i]) + сдвиг)
    конец
    вернуть результат
конец


# ======== Версия 2: С заворачиванием по алфавиту ========

процедура цезарь_алфавит(текст, сдвиг)
    запомнить результат = ""
    запомнить н = длина(текст)
    для i от 0 до н - 1
        запомнить сим = текст[i]
        запомнить код_сим = код(сим)

        // Заглавная А (1040) .. Я (1071) — 32 буквы
        если код_сим >= 1040 и код_сим <= 1071 то
            запомнить смещение = код_сим - 1040 + сдвиг
            пока смещение >= 32
                смещение = смещение - 32
            конец
            пока смещение < 0
                смещение = смещение + 32
            конец
            результат = результат + символ(1040 + смещение)

        # Строчная а (1072) .. я (1103) — 32 буквы
        иначе если код_сим >= 1072 и код_сим <= 1103 то
            запомнить смещение = код_сим - 1072 + сдвиг
            пока смещение >= 32
                смещение = смещение - 32
            конец
            пока смещение < 0
                смещение = смещение + 32
            конец
            результат = результат + символ(1072 + смещение)

        иначе
            # Не буква — оставляем как есть
            результат = результат + сим
        конец
    конец
    вернуть результат
конец


# ======== Демонстрация ========

запомнить сообщение = "Привет, Лу! Как дела?"
запомнить сдвиг_прямо = 3
запомнить сдвиг_обратно = -3

// Простая версия
печать("=== Простой сдвиг (Unicode) ===")
запомнить зашифр1 = выполнить цезарь_unicode(сообщение, сдвиг_прямо)
печать(" Было: " + сообщение)
печать(" Стало: " + зашифр1)
запомнить расшифр1 = выполнить цезарь_unicode(зашифр1, сдвиг_обратно)
печать(" Обратно: " + расшифр1)

// Алфавитная версия
печать("")
печать("=== С заворачиванием по алфавиту ===")
запомнить зашифр2 = выполнить цезарь_алфавит(сообщение, сдвиг_прямо)
печать(" Было: " + сообщение)
печать(" Стало: " + зашифр2)
запомнить расшифр2 = выполнить цезарь_алфавит(зашифр2, сдвиг_обратно)
печать(" Обратно: " + расшифр2)

# Сдвиг на 13 (ROT13 для кириллицы)
печать("")
печать("=== ROT13 (сдвиг 13) ===")
запомнить rot13 = выполнить цезарь_алфавит(сообщение, 13)
печать(rot13)