# Демонстрация всех конструкций языка Lu.
# Запуск:  .venv/bin/lu examples/hello.lu
# Здесь собраны все возможности языка — и «узкие места», которые
# стоит проверить руками.

# ---------- Комментарии ----------
// однострочный через //
# и однострочный через решётку
///
А это многострочный комментарий:
начала и конца у него два и три слеша.
///

# ---------- Переменные и типы данных ----------
запомнить число = 42
запомнить дробное = 3.14
запомнить строка = "Привет, мир"
запомнить символ = 'Л'
запомнить булево = истина
запомнить пусто = ничего
запомнить массив = [1, 2, 3]
запомнить объект = {имя: "Лу", возраст: 5}

# Переназначение переменной без «запомнить»
число = число + 1

# ---------- Арифметика и конкатенация ----------
печать: "Арифметика"
печать: 2 + 3 * 4
печать: (2 + 3) * 4
печать: 100 / 4
печать: -5 + 12
печать: 7 / 2
# Число «склеивается» со строкой:
печать: "У Лу " + 5 + " лап --> лап не бывает, но склейка работает"

# ---------- Сравнения и логика ----------
печать: "Сравнения и логика"
печать: 5 = 5
печать: 5 != 6
печать: 3 < 5 и 4 > 1
печать: 3 > 5 или 4 > 1
печать: не ложь
печать: "а" < "б"

# ---------- Условия: если / иначе если / иначе ----------
запомнить возраст = 6
если возраст > 10 то
    печать: "Старшеклассник"
иначе если возраст >= 7 то
    печать: "Школьник"
иначе если возраст = 6 то
    печать: "Дошкольник (ровно 6)"
иначе
    печать: "Малыш"
конец

# Вложенные условия
запомнить a = 2
если a > 0 то
    если a < 10 то
        печать: "a — небольшое положительное число"
    иначе
        печать: "a большое"
    конец
конец

# ---------- Циклы ----------
печать: "Цикл со счётчиком:"
для i от 1 до 5
    печать: "Шаг " + i
конец

печать: "Цикл «пока»:"
запомнить x = 3
пока x > 0
    печать: x
    x = x - 1
конец

печать: "Цикл «повтори»:"
повтори 3 раз
    печать: "Мяу!"
конец

# ---------- Процедуры ----------
процедура квадрат: число
    вернуть число * число
конец

процедура привет: имя, возраст
    печать: "Привет, " + имя + ", тебе " + возраст + " лет."
конец

запомнить sq = выполнить квадрат: 5
печать: "Квадрат пяти: " + sq
выполнить привет: "Лу", 6

# Рекурсия (факториал)
процедура факториал: n
    если n <= 1 то
        вернуть 1
    конец
    вернуть n * выполнить факториал: n - 1
конец
печать: "5! = " + выполнить факториал: 5

# ---------- Узкие места вызова процедур ----------
# 1) Арифметика внутри аргумента вызова относится к аргументу,
#    а не считается после вызова:
процедура плюс_один: число
    вернуть число + 1
конец
печать: "выполнить плюс_один: 1 + 2  => " + выполнить плюс_один: 1 + 2

# 2) «вернуть» умеет возвращать результат другого вызова:
процедура вернуть_вызов: значение
    вернуть выполнить плюс_один: значение
конец
печать: "вернуть результат вызова: " + выполнить вернуть_вызов: 10

# 3) Несколько аргументов через запятую:
процедура сумма_трёх: a, b, c
    вернуть a + b + c
конец
печать: "Сумма трёх: " + выполнить сумма_трёх: 1, 2, 3

# ---------- Массивы ----------
запомнить фрукты = ["яблоко", "груша", "слива"]
печать: "Первый фрукт: " + фрукты[0]
фрукты[1] = "банан"
печать: "Весь массив: " + фрукты
печать: "Длина массива: " + длина(фрукты)
для i от 0 до длина(фрукты) - 1
    печать: "  элемент " + i + ": " + фрукты[i]
конец

# ---------- Объекты ----------
запомнить кот = {имя: "Лу", возраст: 6, рыжий: истина}
печать: "Имя: " + кот.имя
кот.возраст = 7
кот.цвет = "рыжий"
печать: "Теперь: " + кот.имя + ", " + кот.возраст + " лет, цвет " + кот.цвет
печать: "Весь объект: " + кот

# ---------- Пустые коллекции и границы ----------
запомнить пустой_массив = []
запомнить пустой_объект = {}
печать: "Пустой массив: " + пустой_массив
печать: "Пустой объект: " + пустой_объект
печать: "Длина пустого массива: " + длина(пустой_массив)

# ---------- Булево и ничего в печати ----------
печать: ложь
печать: ничего
запомнить не_нужное = ложь
печать: "Ничего из булева: " + ничего

# ---------- Дружеские ошибки (узкие места) ----------
# Раскомментируй по очереди, чтобы увидеть:
// печать: 1 / 0              // «На ноль делить нельзя!»
// печать: незнакомое_имя     // «Я ещё не знаю, что такое...»
// фрукты[5] = "хурма"        // «В массиве нет элемента с номером 5»

печать: "Всё работает!"