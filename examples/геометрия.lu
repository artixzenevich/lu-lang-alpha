# Модуль lu-lang: геометрия.
# Подключается из примера examples/модули.lu командой:
#     подключить геометрия
#
# Модуль — обычный файл с процедурами. Он выполняется один раз
# при подключении в собственном пространстве имён.

процедура периметр_квадрата(сторона)
    вернуть 4 * сторона
конец

процедура площадь_прямоугольника(ширина, высота)
    вернуть ширина * высота
конец

процедура объём_параллелепипеда(длина_ребра, ширина, высота)
    вернуть длина_ребра * ширина * высота
конец