# Пример модуля на lu-lang.
# Запуск:  .venv/bin/lu examples/модули.lu
#
# Подключает файл геометрия.lu из той же папки. Имя модуля пишется
# без кавычек, короткое имя можно задать через «как».

подключить геометрия

печать("=== Модуль на lu-lang: геометрия ===")
печать("Периметр квадрата со стороной 5: " + выполнить геометрия.периметр_квадрата(5))
печать("Площадь прямоугольника 3 x 4: " + выполнить геометрия.площадь_прямоугольника(3, 4))
печать("Объём параллелепипеда 2 x 3 x 4: " + выполнить геометрия.объём_параллелепипеда(2, 3, 4))

# Короткое имя через «как» — дальше вызываем через г.имя_процедуры()
подключить геометрия как г
печать("Площадь через алиас г: " + выполнить г.площадь_прямоугольника(6, 7))

# Повторное подключение не выполняет тело модуля заново
подключить геометрия
печать("Периметр квадрата со стороной 10: " + выполнить геометрия.периметр_квадрата(10))