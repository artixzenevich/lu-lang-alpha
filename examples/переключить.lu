# Мультиветвление «переключить» и преобразование типов на языке Lu.
# Запуск:  .venv/bin/lu examples/переключить.lu

# ---------- Переключить / случай ----------

запомнить день = 3

переключить день
случай 1
    печать("Понедельник")
случай 2
    печать("Вторник")
случай 3, 4, 5
    печать("Середина недели")
случай 6, 7
    печать("Выходные!")
иначе
    печать("Такого дня не бывает")
конец

# Можно переключать и строки
запомнить сигнал = "красный"
переключить сигнал
случай "красный"
    печать("Стоп")
случай "жёлтый"
    печать("Приготовиться")
случай "зелёный"
    печать("Иди")
конец

# ---------- Преобразование типов ----------

# Строка -> число
запомнить число = тип_число("42")
печать("Строка «42» + 1 = " + (число + 1))

# Запятая как десятичный разделитель — как в ввод()
запомнить рост = тип_число("1,75")
печать("Рост в метрах: " + рост)

# Число -> строка
запомнить текст = тип_строка(100)
печать("Число 100 как текст: " + текст)

# Булево -> строка
запомнить флаг = тип_строка(истина)
печать("Флаг: " + флаг)

# Число из ввода можно сразу превратить и использовать в арифметике:
# запомнить вес = тип_число(ввод())
# печать("Вдвое тяжелее: " + вес * 2)