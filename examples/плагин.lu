# Пример модуля-плагина на Python.
# Запуск:  .venv/bin/lu examples/плагин.lu
#
# Подключает файл текст.py из той же папки. Верхнеуровневые функции
# Python-модуля становятся процедурами lu-lang, доступными через точку.

подключить текст

запомнить фраза = "Лу учит язык программирования"

печать("=== Модуль-плагин на Python: текст ===")
печать("Было: " + фраза)
печать("Перевёрнуто: " + выполнить текст.развернуть(фраза))
печать("Слов в фразе: " + выполнить текст.количество_слов(фраза))
печать(выполнить текст.звёзды(5))

# Плагин можно подключить и под коротким именем
подключить текст как т
печать("Звёзды через алиас т: " + выполнить т.звёзды(3))