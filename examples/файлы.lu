# Работа с файлами на языке Lu.
# Запуск:  .venv/bin/lu examples/файлы.lu
# Пути — строки, относительные к каталогу запуска lu (здесь — корень проекта).
# Имя файла может быть и на русском, и на английском.

# ---------- Запись и чтение ----------

файл_записать("examples/заметки.txt", "Привет, Лу!")
печать("Записали: " + файл_прочитать("examples/заметки.txt"))

# Число при записи превращается в строку, как в печать
файл_записать("examples/числа.txt", 42)
печать("Число в файле: " + файл_прочитать("examples/числа.txt"))

# ---------- Дописывание в конец ----------

файл_записать("examples/дневник.txt", "День 1: солнце")
файл_добавить("examples/дневник.txt", "День 2: дождь")
файл_добавить("examples/дневник.txt", "День 3: снег")
печать("Дневник целиком:")
печать(файл_прочитать("examples/дневник.txt"))

# ---------- Проверка существования и удаление ----------

запомнить имя = "examples/временный.txt"
если файл_существует(имя) то
    печать("Файл уже есть")
иначе
    печать("Файла нет — создаём")
    файл_записать(имя, "временный")
конец

файл_удалить(имя)
печать("После удаления: " + файл_существует(имя))

# ---------- Дружеские ошибки ----------
# Раскомментируй, чтобы увидеть:
// печать(файл_прочитать("examples/не_существует.txt"))
//     «Не нашёл файл "examples/не_существует.txt"»

# Всё сработало
печать("Готово!")