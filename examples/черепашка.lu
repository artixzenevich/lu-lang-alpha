# Графика: черепашка.
# Запуск:  .venv/bin/lu examples/черепашка.lu
# Нужен графический экран (Tkinter). Появится окно с рисунком;
# закрывается крестиком (команда «готово» держит его открытым).

подключить черепашка

# ---------- Квадрат ----------

выполнить черепашка.цвет("синий")
выполнить черепашка.скорость(3)
повтори 4 раз
    выполнить черепашка.вперёд(120)
    выполнить черепашка.вправо(90)
конец

# ---------- Спираль ----------

выполнить черепашка.цвет("красный")
выполнить черепашка.скорость(7)
запомнить шаг = 5
повтори 40 раз
    выполнить черепашка.вперёд(шаг)
    выполнить черепашка.вправо(90)
    шаг = шаг + 5
конец

# ---------- Перемещение без рисования и точка ----------

выполнить черепашка.поднять_перо()
выполнить черепашка.вперёд(250)
выполнить черепашка.опустить_перо()
выполнить черепашка.точка()

# ---------- Круг ----------

выполнить черепашка.цвет("зелёный")
выполнить черепашка.круг(50)

# Окно остаётся открытым, пока его не закроют
выполнить черепашка.готово()