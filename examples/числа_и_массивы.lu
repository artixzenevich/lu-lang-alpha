# Числа и массивы: остаток, перебор, случайное в диапазоне, поиск.
# Запуск:  .venv/bin/lu examples/числа_и_массивы.lu

# ---------- Остаток от деления ----------

печать("Остаток от деления:")
печать("7 % 3 = " + остаток(7, 3))      # 1
печать("10 % 5 = " + остаток(10, 5))    # 0
печать("4 % 2 = " + остаток(4, 2))      # 0 — значит, число чётное
печать("5 % 2 = " + остаток(5, 2))      # 1 — значит, нечётное

# Остаток удобен для циклических номеров: 0..3 повторяются
для i от 1 до 10
    печать("Квадрат " + i + " — " + остаток(i, 2))
конец

# ---------- Перебор массива: для x из массив ----------

запомнить оценки = [5, 4, 5, 3, 5]
запомнить сумма = 0
для оценка из оценки
    печать("Оценка: " + оценка)
    сумма = сумма + оценка
конец
печать("Сумма оценок: " + сумма)

# Перебор строки даёт символы по одному
запомнить слово = "Лу"
для буква из слово
    печать(буква)
конец

# ---------- Случайное число в диапазоне ----------

печать("Бросок кубика 5 раз:")
повтори 5 раз
    печать("  " + случ(1, 6))
конец

# ---------- Поиск в массиве: найти ----------

запомнить фрукты = ["яблоко", "груша", "слива"]
печать("Груша под номером: " + найти(фрукты, "груша"))   # 1
печать("Персик: " + найти(фрукты, "персик"))             # -1

# Игра «угадай число»
запомнить секрет = случ(1, 10)
печать("Загадали число от 1 до 10. Попробуй угадать!")
запомнить попытка = ввод()
если попытка = секрет то
    печать("Угадал!")
иначе
    печать("Нет, это было " + секрет)
конец