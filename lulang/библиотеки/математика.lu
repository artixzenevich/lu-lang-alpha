// Встроенный модуль lu-lang: математика.
// Подключение: подключить математика

процедура квадрат(число)
    вернуть число * число
конец

процедура куб(число)
    вернуть число * число * число
конец

процедура факториал(число)
    если число <= 1 то
        вернуть 1
    конец
    вернуть число * выполнить факториал(число - 1)
конец